{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.0.0",
  "maskStyle": "token",
  "entropyThreshold": 4.5,
  "allowlist": ["sk-live-00000000000000000000000000000000"],
  "ci": {
    "failOnSeverity": "high",
    "ignoreFiles": ["package-lock.json", "pnpm-lock.yaml"]
  },
  "customPatterns": [
    {
      "id": "internal-corp-token",
      "name": "Internal Corp Secret",
      "regex": "CORP_SEC_[a-zA-Z0-9]{16,32}",
      "severity": "critical",
      "category": "generic"
    }
  ],
  "antigravity": {
    "enabled": true,
    "profile": "high-assurance-agent",
    "interceptTools": ["run_command", "write_file", "edit_file"],
    "enforceSandbox": true,
    "requireIsolation": false,
    "quarantineOnCanaryTrip": true,
    "protectedPatterns": [
      "\\.env(?:\\.[a-zA-Z0-9_-]+)?",
      "id_rsa(?:\\.pub)?",
      "id_ed25519",
      "\\.aws[\\/]credentials",
      "\\.ssh[\\/].*"
    ],
    "hooks": {
      "preCommand": "agentshield exec",
      "preWrite": "agentshield scan",
      "auditLog": ".agentshield/antigravity.audit.log"
    }
  }
}
