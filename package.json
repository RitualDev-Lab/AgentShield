{
  "name": "@ritualdev-lab/agentshield",
  "version": "0.1.4",
  "description": "Enterprise-grade Zero-Leak Secret Defense & Sandbox for Autonomous AI Coding Agents",
  "type": "module",
  "bin": {
    "agentshield": "dist/cli.js",
    "ashield": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "SKILL.md", "action.yml"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RitualDev-Lab/AgentShield.git"
  },
  "homepage": "https://ritualdev.in/agentshield/",
  "bugs": {
    "url": "https://github.com/RitualDev-Lab/AgentShield/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test",
    "benchmark": "tsx src/cli.ts benchmark",
    "prepublishOnly": "pnpm run build && pnpm test && npm pack --dry-run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "wiki:sync": "node scripts/sync-wiki.cjs"
  },
  "keywords": [
    "ai-agent-security",
    "mcp-server",
    "sandbox",
    "developer-tools",
    "cursor-ide",
    "windsurf-ai",
    "llm-security",
    "kernel-sandbox",
    "bubblewrap",
    "landlock",
    "seatbelt-macos",
    "secret-detection",
    "zero-leak"
  ],
  "author": "RitualDev Lab (https://github.com/RitualDev-Lab)",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
