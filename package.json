{
  "name": "@ritualdev-lab/agentshield",
  "version": "0.1.3",
  "description": "Enterprise-grade Zero-Leak Secret Defense & Sandbox for Autonomous AI Coding Agents",
  "type": "module",
  "bin": {
    "agentshield": "dist/cli.js",
    "ashield": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "action.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RitualDev-Lab/AgentShield.git"
  },
  "homepage": "https://github.com/RitualDev-Lab/AgentShield#readme",
